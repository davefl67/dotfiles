# Shim for ~/.bashrc:
# 1) source repo-managed bashrc
# 2) source user-local overrides

shim_path="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  shim_path="$(readlink -f "$shim_path" 2>/dev/null || printf '%s' "$shim_path")"
fi

shim_dir="$(cd -- "$(dirname -- "$shim_path")" && pwd)"
repo_bashrc="${shim_dir}/bashrc"

if [[ -r "$repo_bashrc" ]]; then
  . "$repo_bashrc"
fi

if [[ -r "$HOME/.bashrc.local" ]]; then
  . "$HOME/.bashrc.local"
fi
