add_newline = false
format = "$directory$git_branch$git_status$character"

[directory]
truncation_length = 3
truncate_to_repo = false

[git_branch]
format = " [$symbol$branch]($style)"

[git_status]
format = "[$all_status$ahead_behind]($style)"

[character]
success_symbol = "[>](bold green) "
error_symbol = "[>](bold red) "
